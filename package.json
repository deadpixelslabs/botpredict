{
  "name": "predict-fun-vercel",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "node scripts/build.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "start:worker": "node dist/worker.cjs",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm test && npm run build && npm run test:native",
    "paper:report": "node --import tsx scripts/paper-report.ts",
    "test:native": "node --test tests/native-handler.test.mjs"
  },
  "dependencies": {
    "@predictdotfun/sdk": "^1.3.6",
    "@vercel/blob": "2.8.2",
    "@vercel/oidc": "4.0.4",
    "axios": "^1.18.1",
    "bignumber.js": "^11.1.4",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "express": "^4.21.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "chart.js": "4.4.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
